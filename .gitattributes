
# LaserSynth Git line-ending configuration

# Default: automatically detect text files
* text=auto

# Max project and patcher JSON
*.maxpat text eol=lf
*.maxproj text eol=lf
*.maxhelp text eol=lf
*.json text eol=lf

# Max code and GenExpr
*.gendsp text eol=lf
*.genexpr text eol=lf
*.js text eol=lf
*.lua text eol=lf

# Other text files
*.svg text eol=lf
*.md text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files - never perform line-ending conversion
*.wav binary
*.aif binary
*.aiff binary
*.mp3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mex64 binary
